# 1. Imagen base oficial y ligera basada en Alpine Linux
FROM nginx:1.25-alpine


# 2. Copiar sitio web estático al directorio predeterminado de NGINX
COPY ./index.html /usr/share/nginx/html/index.html

# 3. Informar que el contenedor escucha en el puerto 80
EXPOSE 80

# 4. Comando de ejecución en segundo plano (propio de la imagen base NGINX)
CMD ["nginx", "-g", "daemon off;"]